-- allium: 3
-- skilj-helpdesk.allium

-- Scope: SkilJ Helpdesk, a showcase SaaS application built on the SkilJ
--   library (see skilj.allium in the skilj repo for the platform this
--   sits on top of). A company signs up for a one-month free trial, then
--   must start paying to keep using the product. Once onboarded, the
--   company's staff can raise, prioritise, and work through support
--   tickets, with the full event history visible in a web UI, and staff
--   holding a given role get alerted about tickets that aren't being
--   handled.
-- Includes:
--   - Company signup and the free-trial-to-paid lifecycle
--   - Provisioning a company as its own SkilJ tenant (bounded context),
--     via SkilJ's existing template/tenant mechanism
--   - Ticket creation, priority, and the states a ticket moves through
--     on the way to being handled
--   - Alerting staff with a given role about tickets that need attention
--   - SLA policies: per-company first-response and resolution targets per
--     priority, counted in business hours, escalating a ticket on breach
--   - Full ticket/event history, browsable in a UI, via SkilJ's own
--     GraphQL surface (SkilJ already specifies that surface; this spec
--     only says what history must be visible, not the wire contract)
-- Excludes:
--   - Real payment processing: mocked, since this is a showcase, not a
--     real billing product. Modelled as a black box (see
--     PaymentGateway.charge in TrialPeriodEnds below); the actual charge
--     outcome is not this spec's concern beyond "succeeded" or "failed".
--     CompanySubscribes doesn't call it at all - see that rule's own
--     comment for why.
--   - UI visual design, branding, layout: presentation-level, not domain
--     behaviour
--   - SkilJ's own library guarantees (bounded-context templating,
--     RoleAccessMapping, event subscriptions/REST tokens, encryption):
--     assumed as given, not re-specified here. See Dependencies.
--   - The specific channel a person is alerted through (email, Slack,
--     etc.): the alerting service's concern, not this spec's
--   - Ongoing/recurring billing cycles beyond the single trial-to-paid
--     transition: once a company is active, this showcase doesn't model
--     further charge attempts or subscription lapses from non-payment -
--     a deliberate simplification, not an oversight (see Company.status)
-- Dependencies: This spec builds on concepts defined in skilj.allium -
--   BoundedContext (a company is provisioned as a tenant of a
--   "helpdesk" template context), Role / RoleAccessMapping (staff
--   identity and per-company access), and the REST event-read surface
--   (EventReadToken, GET /v1/events/consume) that a separately
--   deployable alerting service consumes rather than being part of
--   SkilJ core itself - see the design note below.
-- Bounded contexts (weeded 2026-10-12, see
--   docs/allium-spec-drift-2026-10-12.md): this spec is the shared
--   `helpdesk` context plus the per-company tenants stamped from it.
--   Company lifecycle is decided only in the shared context; each
--   tenant holds a mirror of it (rule TenantLifecycleIsMirrored) for its
--   own ticket-creation guard to read. Ticket traffic runs in the
--   shared context unless the deployment opts in to routing it into the
--   company's tenant (TICKET_ROUTING=tenant, falling back to the shared
--   context for a company with no tenant yet) - a deployment choice,
--   not a behaviour this spec distinguishes. activity.allium and
--   marketing.allium are two further bounded contexts reading from this
--   one.

-- Design note (resolved, not an open question): whether alerting needs
-- new SkilJ platform functionality, or can be built as a plain consumer
-- of what SkilJ already exposes.
--   Checked against skilj.allium and docs/architecture.md 7.4: SkilJ
--   already offers a server-tracked, auto-advancing REST event feed
--   (GET /v1/events/consume?mode=auto, backed by a per-token EventReadToken)
--   explicitly meant for "a stateless worker ... simplest to use,
--   occasional missed events on crash is acceptable" - exactly the
--   alerting service's shape. No change to SkilJ itself is needed: the
--   alerting service is an ordinary separately-deployable unit that
--   holds an EventReadToken scoped to the ticket bounded context's
--   event types and reacts to the events it reads.
--   One real gap this surfaces: SkilJ's own Role deliberately carries no
--   contact information (id and external_subject only, kept free of
--   PII by design) - so "alert everyone with role X" needs a
--   helpdesk-domain concept of who holds that role and how to reach
--   them; SkilJ's Role/RoleAccessMapping only answers "may this JWT
--   subject act here," not "where do we send a message." That's
--   StaffMember below, not a SkilJ concept.

enum CompanyStatus { trialing | active | expired }

config {
    trial_duration: Duration = 1.month

    -- The CSAT scale RateTicket accepts - see CustomerRatesTicket.
    min_rating: Integer = 1
    max_rating: Integer = 5

    -- A ticket nobody has picked up in this long is overdue - see
    -- TicketBecomesOverdue. Common industry default (e.g. Zendesk,
    -- HelpDesk.com priority-tier guidance); tune per priority level in
    -- a later pass if a single flat threshold proves too coarse.
    unhandled_alert_after: Duration = 4.hours

    -- A resolved ticket nobody reopened auto-closes after this long -
    -- standard helpdesk convention (Zendesk, Freshdesk).
    auto_close_after: Duration = 7.days
}

-- Cross-spec import, resolved: skilj.allium lives in a sibling repo
-- checked out alongside this one (../skilj relative to this project's
-- root). Local relative-path `use` per the language reference, not a
-- pinned remote coordinate - skilj isn't published anywhere with a
-- stable git-SHA coordinate, and it's developed in lockstep with this
-- app rather than versioned independently, so that's the right choice
-- here, not a placeholder. Because of it, checking this spec needs both
-- files in the check set:
--   allium check specs/skilj-helpdesk.allium ../skilj/specs/skilj.allium
use "../../skilj/specs/skilj.allium" as skilj

-- SLA policies (issue #42). Zendesk/Zammad treat them as core; FreeScout
-- is criticised for lacking them. A company's policy sets, per ticket
-- priority, how long until staff first answer the customer and how long
-- until the ticket is resolved, both counted in business hours only.
--
-- Resolved: business hours are a UTC hour range on a set of weekdays, not
-- local time in a named timezone - `src/sla.rs`'s own doc comment gives
-- the trade-off (no tz/DST rules to specify; a non-UTC company enters its
-- hours shifted). Resolved: the policy lives on the company, with one
-- default for every company that never set its own (09:00-17:00 UTC,
-- Monday to Friday; urgent 1h/8h, high 4h/16h, medium 8h/40h, low
-- 16h/80h first response/resolution - `SlaPolicy::default()`).

value BusinessHours {
    open_hour: Integer              -- UTC, 0..23
    close_hour: Integer             -- UTC, 1..24, after open_hour
    working_days: Set<Integer>      -- ISO weekdays: 1 = Monday ... 7 = Sunday, at least one
}

value SlaTarget {
    first_response: Duration        -- business time, at most the resolution target
    resolution: Duration            -- business time
}

value SlaPolicy {
    business_hours: BusinessHours
    low: SlaTarget
    medium: SlaTarget
    high: SlaTarget
    urgent: SlaTarget
}

entity Company {
    -- Caller-supplied, checked for uniqueness on signup (see rule
    -- CompanySignsUp) - the same caller-supplied-identifier shape
    -- Customer/StaffMember's own external_subject already is. Distinct
    -- from this entity's own Allium identity, which stays implicit as
    -- usual - this is the wire-level idempotency key a real caller
    -- submits, caught missing from this entity during weeding (the
    -- real decide() already keys on it).
    company_id: String

    name: String
    contact_email: String
    status: CompanyStatus
    trial_started_at: Timestamp

    -- Provisioned in reaction to the signup (resolved below) - one
    -- tenant per company, for the lifetime of the company. Absent until
    -- the provisioner has reported back (rule CompanyTenantIsRecorded):
    -- caught during weeding, this was previously set by CompanySignsUp
    -- itself, but decide() is I/O-free and the tenant is created
    -- afterwards, by a separate reactor.
    tenant: skilj/BoundedContext?

    -- The company's status as its own tenant last heard it - see rule
    -- TenantLifecycleIsMirrored. Absent until the first mirror lands.
    -- Never decided in the tenant, only copied there.
    mirrored_status: CompanyStatus?

    tickets: Ticket with company = this

    -- Absent until the company sets one (rule CompanySetsSlaPolicy);
    -- tickets created meanwhile run under the default policy.
    sla_policy: SlaPolicy?

    -- Resolved: expiry is a soft, reversible restriction, not a
    -- cutoff. Creating new tickets is the only thing disallowed while
    -- expired (enforced as a requires-guard on Ticket's creation rules
    -- below) - everything else, including working existing tickets to
    -- resolution, stays available. Existing data stays visible and
    -- browsable regardless of status either way; a UI banner
    -- prompting re-subscription is a presentation concern, out of
    -- scope here. A company can return and pay at any later time to
    -- become active again - there is no point of no return.
    transitions status {
        trialing -> active
        trialing -> expired
        expired -> active
        terminal: active   -- this showcase doesn't model ongoing/recurring
                            -- billing beyond the initial trial-to-paid
                            -- transition - see Excludes
    }
}

-- Resolved: signup is fully automatic. The helpdesk's own backend holds
-- superadmin-level credentials and provisions the tenant itself the
-- moment the form is submitted - no manual/admin approval step.
rule CompanySignsUp {
    when: SignUpCompany(company_id, name, contact_email)
    -- Rejected as `already_signed_up` when this company_id was already
    -- used - caught during weeding: the real decide() has always
    -- guarded this, just missing from this rule.
    requires: not exists Company{company_id: company_id}
    -- Also rejected for an empty company_id or name, either longer than
    -- 256 characters, or a contact_email that isn't a plausible address
    -- (`empty_company_id`, `empty_company_name`, `company_id_too_long`,
    -- `company_name_too_long`, `invalid_email`) - input validation,
    -- left to the code rather than restated here.
    ensures: Company.created(
        company_id: company_id,
        name: name,
        contact_email: contact_email,
        status: trialing,
        trial_started_at: now
    )
    @guidance
        -- The tenant is provisioned in reaction to the CompanySignedUp
        -- this commits, not inside the decision (decide() is pure): the
        -- provisioner calls skilj/CreateBoundedContextFromTemplate with
        -- template "helpdesk", with superadmin authority, and reports the
        -- result back through rule CompanyTenantIsRecorded. Black box,
        -- same register as PaymentGateway.charge below: what that skilj
        -- rule requires/guarantees is skilj.allium's concern.
}

-- Weeded 2026-10-12: the provisioner's report-back, previously folded
-- into CompanySignsUp. Rejected as `company_not_found` for a company
-- that never signed up, and as `tenant_already_provisioned` for a
-- redelivered report - the event feed can deliver CompanySignedUp twice.
rule CompanyTenantIsRecorded {
    when: RecordCompanyTenant(company, tenant)
    requires: company.tenant = null
    ensures: company.tenant = tenant
}

-- Weeded 2026-10-12: the lifecycle mirror the multi-context move added.
-- A tenant has no copy of the shared context's lifecycle events, so the
-- lifecycle replicator copies each one in. Only ever forwards along the
-- lifecycle (trialing, then expired, then active), never back, which
-- makes the mirror independent of the order the replicator's separate
-- feeds deliver in; a repeat is rejected `lifecycle_already_mirrored`, a
-- step back `lifecycle_regression`. Within a tenant the mirror is the
-- status CustomerCreatesTicket/StaffLogsTicketOnBehalf read.
rule TenantLifecycleIsMirrored {
    when: RecordTenantLifecycle(company, status)
    requires: status != company.mirrored_status
    requires: company.mirrored_status != active
    requires: status != trialing or company.mirrored_status = null
    ensures: company.mirrored_status = status
}

rule TrialPeriodEnds {
    when: company: Company.trial_started_at + config.trial_duration <= now
    requires: company.status = trialing
    let charged = PaymentGateway.charge(company)   -- mocked: this is a showcase,
                                                    -- not a real billing integration
    ensures:
        if charged.succeeded:
            company.status = active
        else:
            company.status = expired
    @guidance
        -- The mocked charge is decided when the company signs up, not
        -- when the trial ends: skilj's native deadlines schedule one
        -- fixed command per source event, so the code schedules either
        -- the conversion or the expiry up front (both re-check
        -- `trialing` when they fire, `company_not_trialing` otherwise).
        -- Equivalent while the mock is deterministic; a real gateway
        -- would move the charge to fire time.
}

-- Resolved: a company that lapsed (or never converted) can subscribe at
-- any later point and regain full access immediately - no re-approval,
-- symmetric with signup itself being self-service. Trigger named
-- `ReactivateCompany` to match the real command name (caught during
-- weeding - this rule previously called it `Subscribe`). Unconditional,
-- unlike `TrialPeriodEnds` above - caught during weeding: the real
-- `ReactivateCompany::decide()` never calls `PaymentGateway.charge` or
-- branches on its outcome at all ("a real payment retry-on-failure UX
-- is presentation-level, out of this pass's scope" - its own doc
-- comment); this rule previously modeled a `charged.succeeded` branch
-- that was never implemented and has no `else`, so a rejected charge
-- would have silently done nothing rather than reject the command -
-- removed rather than implemented, since the code's own simplification
-- is the one actually running.
rule CompanySubscribes {
    when: ReactivateCompany(company)
    requires: company.status = expired
    ensures: company.status = active
    @guidance
        -- Reachable over REST with a ReactivateCompany command token;
        -- the frontend has no resubscribe button yet (see
        -- CompanyResubscription).
}

-- Ticket system. Shaped after standard helpdesk convention (Zendesk,
-- Freshdesk, HelpDesk.com) rather than asked field-by-field: an
-- Open/In Progress/Pending/Resolved/Closed lifecycle and a four-tier
-- Low/Medium/High/Urgent priority scale are close to industry-universal,
-- so this is a draft to react to, not a series of further questions.

-- Every logged-in identity here is a skilj Role scoped to this specific
-- company's tenant (via RoleAccessMapping) - see the Dependencies note
-- above. Customer and StaffMember are kept as separate entities rather
-- than one "Person with a role" because they sit on opposite sides of
-- the surface boundary (customer portal vs. agent dashboard) and only
-- StaffMember carries a role relevant to alerting.

entity Customer {
    company: Company
    external_subject: String       -- the IdP subject this identity is bound to (see skilj.allium's Role)
    contact_email: String

    @guidance
        -- Personal data, erasable on request (GDPR art. 17). Everything
        -- a customer writes or is asked on a ticket - title,
        -- description, the info-request conversation, a rating comment -
        -- and their name and email are skilj `sensitive_fields`,
        -- encrypted under one key per customer (subject `customer`,
        -- keyed by the requester's id). Erasure is skilj.allium's own
        -- `ForgetSubject` on that subject: the key is destroyed, so all
        -- of it stays unreadable, and a pending auto-close naming the
        -- customer is resolved `forgotten`. Hence the read side is split:
        -- a per-company queue with no customer text, and a per-customer
        -- view of the text, since skilj decrypts a projection only
        -- against the row's own key. Every command carrying a customer's
        -- text must name the ticket's own requester, or it would be
        -- filed under someone else's key.
}

entity StaffMember {
    company: Company
    external_subject: String
    contact_email: String

    -- "A certain role" resolved as a fixed two-tier split: not every
    -- agent gets paged for an overdue/urgent ticket, only a lead/on-call
    -- does (see TicketBecomesOverdue). A per-company configurable role
    -- set is more flexible but adds real modelling weight (who defines
    -- the set, per company or globally) for a showcase - deferred, not
    -- forgotten, if it turns out two tiers is too rigid.
    role: agent | lead
}

entity Ticket {
    company: Company
    title: String
    description: String
    priority: low | medium | high | urgent
    status: open | in_progress | waiting_on_customer | resolved | closed | merged
    requester: Customer
    logged_by: StaffMember?         -- absent when the customer filed it themselves;
                                     -- present when staff logged it on their behalf
    -- Kept when the ticket is merged away (weeded 2026-10-12): the
    -- merge doesn't unassign the duplicate.
    assigned_to: StaffMember? when status = in_progress | waiting_on_customer | resolved | closed | merged
    created_at: Timestamp
    resolved_at: Timestamp? when status = resolved | closed

    -- Not in the original elicitation - added alongside `rule
    -- TicketBecomesOverdue`'s own extension below, `rule
    -- StaffMergesTickets`, and `rule CustomerRatesTicket`, each a real
    -- pattern from Zendesk/Freshdesk/Jira Service Management this
    -- showcase's own telemetry work wanted real traffic variety to
    -- demonstrate.
    escalated: Boolean = false

    -- One CSAT rating per ticket, for good (weeded 2026-10-12): it was
    -- previously present only `when status = resolved | closed`, but a
    -- rated ticket that is reopened or merged keeps its rating, and the
    -- code refuses a second one (`already_rated`) even after the ticket
    -- is resolved again.
    rating: Integer?

    -- SLA (issue #42), fixed at creation from the company's policy (or
    -- the default) for the ticket's priority at that moment: a later
    -- policy change or escalation doesn't move its deadlines.
    sla_hours: BusinessHours
    sla: SlaTarget
    first_response_due_at: add_business_time(created_at, sla.first_response, sla_hours)
    resolution_due_at: add_business_time(created_at, sla.resolution, sla_hours)
    -- Set by the first staff message to the customer (a question, or a
    -- macro's reply - see StaffAppliesMacro), or by resolving - picking a
    -- ticket up is not a response.
    first_responded_at: Timestamp?
    -- Set by the first resolution and never cleared, unlike
    -- `resolved_at`: what meets the resolution SLA (weeded 2026-10-12 -
    -- the breach rule previously read `resolved_at`, which a reopen
    -- clears, so a reopened ticket that met its target could still be
    -- marked breached).
    first_resolved_at: Timestamp?
    first_response_breached: Boolean = false
    resolution_breached: Boolean = false

    -- What "keeps track of what's not handled" means concretely: any
    -- ticket short of resolved, closed, or merged - a merged ticket has
    -- nothing left to do either, same reason a closed one doesn't.
    unhandled: status not in {resolved, closed, merged}

    transitions status {
        open -> in_progress
        in_progress -> waiting_on_customer
        waiting_on_customer -> in_progress
        in_progress -> resolved
        resolved -> in_progress
        resolved -> closed
        open -> merged
        in_progress -> merged
        waiting_on_customer -> merged
        resolved -> merged
        terminal: closed, merged
    }

    -- No `transitions priority {}` graph declared - transition graphs are
    -- opt-in (checker emits nothing for a field that lacks one), and the
    -- installed `allium` CLI (3.5.3) mis-analyses `status`'s own graph
    -- when a second `transitions` block is present on the same entity
    -- (verified: removing this block alone silences a page of spurious
    -- `status.undeclaredTransition` findings against `status` itself,
    -- despite that graph being unchanged) - a real installed-CLI-vs-
    -- reference-docs version gap (3.5.3 vs the 3.8.0 skill docs), not a
    -- reason to leave `status` unchecked. `rule StaffEscalatesTicket`
    -- below still sets `ticket.priority` via an ordinary `ensures`.
}

-- Both creation rules are one CreateTicket command in code
-- (`logged_by_staff_id` tells them apart). Besides the company guard it
-- is rejected `company_not_found` for a company that never signed up,
-- and `ticket_already_exists` for a ticket id already used - by any
-- company (weeded 2026-10-12: ticket ids were only unique per company,
-- yet the ticket's tag, snapshot and read models know it by id alone,
-- so a second company's ticket landed on the first one's and reset it
-- to open). The ticket's identity is implicit here, as usual.
-- `sla_policy_for(company)`: the company's own `sla_policy`, or the
-- default policy when it has none (black box: the default's values are in
-- the SLA note above). `target_for(policy, priority)`: the policy's
-- SlaTarget for that priority.
rule CustomerCreatesTicket {
    when: CreateTicket(company, requester, title, description, priority)
    requires: company.status != expired
    let policy = sla_policy_for(company)
    ensures: Ticket.created(
        company: company, title: title, description: description,
        priority: priority, status: open, requester: requester, created_at: now,
        sla_hours: policy.business_hours, sla: target_for(policy, priority)
    )
}

rule StaffLogsTicketOnBehalf {
    when: LogTicketOnBehalf(company, staff, requester, title, description, priority)
    requires: company.status != expired
    let policy = sla_policy_for(company)
    ensures: Ticket.created(
        company: company, title: title, description: description,
        priority: priority, status: open, requester: requester,
        logged_by: staff, created_at: now,
        sla_hours: policy.business_hours, sla: target_for(policy, priority)
    )
    @guidance
        -- CreateTicket is not role-gated, so `logged_by` is whatever the
        -- caller names; nothing checks it is a staff member. The
        -- frontend never sets it yet.
}

rule StaffPicksUpTicket {
    when: AssignTicket(ticket, staff)
    requires: ticket.status = open
    ensures: ticket.status = in_progress
    ensures: ticket.assigned_to = staff
}

rule StaffRequestsInfo {
    when: RequestInfoFromCustomer(ticket, staff)
    requires: ticket.status = in_progress
    ensures: ticket.status = waiting_on_customer
    ensures: ticket.first_responded_at = ticket.first_responded_at ?? now
}

rule CustomerReplies {
    when: CustomerRespondsToTicket(ticket, requester)
    -- `requester_mismatch` otherwise - see Customer's guidance.
    requires: requester = ticket.requester
    requires: ticket.status = waiting_on_customer
    ensures: ticket.status = in_progress
}

rule StaffResolvesTicket {
    when: ResolveTicket(ticket, staff)
    requires: ticket.status = in_progress
    ensures: ticket.status = resolved
    ensures: ticket.resolved_at = now
    ensures: ticket.first_resolved_at = ticket.first_resolved_at ?? now
    ensures: ticket.first_responded_at = ticket.first_responded_at ?? now
}

rule TicketReopened {
    when: ReopenTicket(ticket)
    requires: ticket.status = resolved
    ensures: ticket.status = in_progress
}

-- Weeded 2026-10-12: staff can close a resolved ticket without waiting
-- for TicketAutoCloses - the same CloseTicket command, staff-only, behind
-- the dashboard's Close button. The pending auto-close then fires into a
-- closed ticket and is rejected.
rule StaffClosesTicket {
    when: CloseTicket(ticket, staff)
    requires: ticket.status = resolved
    ensures: ticket.status = closed
}

rule TicketAutoCloses {
    when: ticket: Ticket.resolved_at + config.auto_close_after <= now
    requires: ticket.status = resolved
    ensures: ticket.status = closed
    @guidance
        -- allium analyse flags this against TicketReopened: both can
        -- apply while resolved, setting status to conflicting values.
        -- Resolved: reopening wins - it's a human signal that the
        -- issue isn't actually settled, which should override a
        -- housekeeping timer. In practice this falls out of ordinary
        -- sequential event processing (whichever happens first is what
        -- the ticket's state reflects), noted here so it's not silently
        -- unspecified.
        -- The timer runs from the latest `resolved_at`: a ticket resolved,
        -- reopened and resolved again waits the full period from its
        -- second resolution. `src/helpdesk/ticket_commands.rs` keeps this by cancelling
        -- a resolution's deadline when it is reopened
        -- (`CancelTicketAutoCloseOnReopen`), not only by re-checking
        -- status when the deadline fires.
}

-- Alerting. Resolved design note above: this only decides *when* a
-- ticket is alert-worthy: the trigger emission below is what a
-- separately-deployable service (reading it off skilj's REST event
-- feed, per the design note above) turns into an actual email/Slack/etc
-- message - that fan-out is deliberately not this spec's concern.
--
-- @guidance
--     Extended beyond the original elicitation: this rule originally
--     only emitted `TicketNeedsAttention` - a page, nothing durable.
--     Real practice (Zendesk/Jira Service Management SLA-breach
--     escalation) doesn't stop at paging someone: it bumps the ticket's
--     own priority (optionally reassigns it too - not modelled here,
--     this showcase has no formal "who's the backup agent" concept
--     beyond the single `lead` role already used for paging). Added so
--     an overdue ticket becomes a real, durable, once-only fact
--     (`ticket.escalated`), not just a transient notification - and so
--     this project's own telemetry work has real command/event traffic
--     to show, not only a console alert. `escalate` is a black box
--     (same treatment as `PaymentGateway.charge` above): a one-tier
--     priority bump, low -> medium -> high -> urgent, clamped at
--     urgent - see `src/helpdesk/ticket.rs`'s own `escalate_priority`.
rule TicketBecomesOverdue {
    when: ticket: Ticket.created_at + config.unhandled_alert_after <= now
    requires: ticket.unhandled
    requires: not ticket.escalated
    let new_priority = escalate(ticket.priority)
    ensures: ticket.priority = new_priority
    ensures: ticket.escalated = true
    for lead in StaffMembers where company = ticket.company and role = lead:
        ensures: TicketNeedsAttention(ticket, lead)
}

-- SLA breaches (issue #42). `add_business_time(start, duration, hours)`
-- is a black box: `start` plus `duration` counted only inside `hours`'
-- daily window on its working days - nights, weekends and other days
-- don't count (`src/sla.rs`'s `add_business_minutes`, unit-tested there).
--
-- @guidance
--     Implemented with skilj's native deadlines: `TicketCreated` schedules
--     one deadline per SLA (`ScheduleFirstResponseSla`/
--     `ScheduleResolutionSla`), and the events that meet an SLA cancel it
--     (`CancelFirstResponseSlaOnStaffReply`/`...OnMacroReply`/`...OnResolve`,
--     `CancelResolutionSlaOnResolve`) - the `requires` below are still
--     re-checked when a deadline fires, so one that escaped its cancel
--     changes nothing. The resolution SLA runs to the first resolution
--     only: a reopen doesn't restart it (TicketBecomesOverdue still
--     covers a reopened ticket). Escalation is TicketBecomesOverdue's
--     own one-tier bump, applied only if the ticket isn't escalated
--     already; the breach is recorded either way.
rule TicketBreachesFirstResponseSla {
    when: ticket: Ticket.first_response_due_at <= now
    requires: ticket.unhandled
    requires: ticket.first_responded_at = null
    requires: not ticket.first_response_breached
    ensures: ticket.first_response_breached = true
    ensures: SlaBreached(ticket, first_response)
    if not ticket.escalated:
        ensures: ticket.priority = escalate(ticket.priority)
        ensures: ticket.escalated = true
}

rule TicketBreachesResolutionSla {
    when: ticket: Ticket.resolution_due_at <= now
    requires: ticket.unhandled
    requires: ticket.first_resolved_at = null
    requires: not ticket.resolution_breached
    ensures: ticket.resolution_breached = true
    ensures: SlaBreached(ticket, resolution)
    if not ticket.escalated:
        ensures: ticket.priority = escalate(ticket.priority)
        ensures: ticket.escalated = true
}

rule CompanySetsSlaPolicy {
    when: SetCompanySlaPolicy(company, policy)
    requires: valid_sla_policy(policy)
    ensures: company.sla_policy = policy
    @guidance
        -- `valid_sla_policy` is the black box `SlaPolicy::validate`:
        -- the constraints written beside BusinessHours/SlaTarget's own
        -- fields, plus each target at most a year. Replaces the whole
        -- policy; tickets already created keep theirs.
}

rule UrgentTicketNeedsImmediateAttention {
    when: ticket: Ticket.created
    requires: ticket.priority = urgent
    for lead in StaffMembers where company = ticket.company and role = lead:
        ensures: TicketNeedsAttention(ticket, lead)
}

-- Three more flows, none in the original elicitation - each a real
-- pattern from Zendesk/Freshdesk/Jira Service Management, added for the
-- same reason `TicketBecomesOverdue`'s own extension above was: this
-- showcase's telemetry/dashboard work wanted genuinely varied traffic to
-- demonstrate, not traffic invented for its own sake.

-- The showcase of skilj's own DCB model this spec hadn't yet
-- demonstrated: one command, two tickets, no aggregate boundary needed -
-- `src/helpdesk/ticket_commands.rs`'s own `MergeTickets` is the real
-- mechanism this requires-guard relies on (two ticket snapshots read
-- at once). `duplicate.company = primary.company` is stated as its own
-- `requires` rather than left implicit, since nothing else here compares
-- two different tickets' own company at all.
rule StaffMergesTickets {
    when: MergeTickets(primary, duplicate)
    requires: primary != duplicate
    requires: primary.company = duplicate.company
    requires: primary.status not in {closed, merged}
    requires: duplicate.status not in {closed, merged}
    ensures: duplicate.status = merged
}

-- A CSAT survey response - standard practice once a ticket is handled,
-- not gated on `closed` alone: real tools survey right after
-- resolution, not after `config.auto_close_after`'s own multi-day wait.
-- One rating per ticket, ever (`already_rated`), on the
-- config.min_rating..max_rating scale (`invalid_rating`), and only by the
-- ticket's own requester (`requester_mismatch`) - all three in the code
-- all along, stated here since weeding 2026-10-12.
rule CustomerRatesTicket {
    when: RateTicket(ticket, requester, rating)
    requires: requester = ticket.requester
    requires: ticket.status = resolved | closed
    requires: ticket.rating = null
    requires: rating >= config.min_rating and rating <= config.max_rating
    ensures: ticket.rating = rating
}

-- A staff-only note - no entity field changes (deliberately not folded
-- into anything a customer-facing surface exposes; see
-- `CustomerTicketView`/`StaffTicketView` below - only the latter
-- provides this), just a durable fact for the record, the same "ensures
-- a named fact, not an entity field" shape `TicketNeedsAttention` above
-- already uses.
rule StaffAddsInternalNote {
    when: AddInternalNote(ticket, staff)
    ensures: InternalNoteAdded(ticket, staff)
}

-- Macros (canned responses, issue #43): a company's reusable staff
-- replies, each optionally also moving the ticket's status and/or
-- priority. Standard helpdesk tooling (Zendesk macros, Freshdesk canned
-- responses).
--
-- @guidance
--     Lives in the helpdesk context itself, not a context of its own:
--     applying one decides on the macro and the ticket together, and a
--     skilj consistency query only reads its own context. A separate
--     context would leave the caller to send the macro's content along,
--     so a macro deleted or edited meanwhile would still be applied as
--     it was. See `src/helpdesk/macros.rs`.
entity Macro {
    company: Company
    macro_id: String        -- caller-supplied, never reused, deleted or not
    name: String
    body: String            -- `{{ticket_id}}`/`{{staff_id}}` filled in on apply
    sets_status: waiting_on_customer | resolved | none
    sets_priority: low | medium | high | urgent | none
}

rule StaffCreatesMacro {
    when: CreateMacro(company, macro_id, name, body, sets_status, sets_priority)
    requires: exists company
    -- Stricter in code (`macro_already_exists`): a deleted macro's id
    -- stays used too - see Macro.macro_id.
    requires: not exists Macro{company: company, macro_id: macro_id}
    requires: name != "" and body != ""
    ensures: Macro.created(
        company: company, macro_id: macro_id, name: name, body: body,
        sets_status: sets_status, sets_priority: sets_priority
    )
}

rule StaffEditsMacro {
    when: UpdateMacro(macro, name, body, sets_status, sets_priority)
    requires: name != "" and body != ""
    ensures: macro.name = name
    ensures: macro.body = body
    ensures: macro.sets_status = sets_status
    ensures: macro.sets_priority = sets_priority
}

rule StaffDeletesMacro {
    when: DeleteMacro(macro)
    ensures: not exists macro
}

-- One command, all or nothing: the reply, a priority change when the
-- macro sets a different one, and the status change through the very
-- rule of `StaffRequestsInfo`/`StaffResolvesTicket` (both `requires:
-- ticket.status = in_progress`) - any part rejected rejects the whole.
-- A `waiting_on_customer` macro's reply *is* the info request; any other
-- reply is a `StaffReplied` that leaves the status alone.
rule StaffAppliesMacro {
    when: ApplyMacro(ticket, macro, staff)
    requires: macro.company = ticket.company
    requires: ticket.status not in {closed, merged}
    requires: macro.sets_status = none or ticket.status = in_progress
    let reply = render(macro.body, ticket, staff)
    ensures:
        if macro.sets_priority != none:
            ticket.priority = macro.sets_priority
    ensures:
        if macro.sets_status = waiting_on_customer:
            ticket.status = waiting_on_customer
        else:
            StaffReplied(ticket, staff, reply)
    -- Either way the customer heard from staff: it meets the
    -- first-response SLA (TicketBreachesFirstResponseSla).
    ensures: ticket.first_responded_at = ticket.first_responded_at ?? now
    ensures:
        if macro.sets_status = resolved:
            ticket.status = resolved
            ticket.resolved_at = now
            ticket.first_resolved_at = ticket.first_resolved_at ?? now
    @guidance
        -- Resolving through a macro is StaffResolvesTicket's own decision,
        -- so it frees the assignee up for StaffAutoAssignsTicket exactly
        -- as a direct resolve does.
}

-- Load-based auto-assignment (issue #44): the open ticket goes to
-- whichever of the named candidates has the fewest open tickets - an
-- agent's open tickets being those assigned to them with status
-- in_progress or waiting_on_customer. `least_loaded` is a black box
-- (same treatment as `escalate` above): fewest open tickets, a tie going
-- to the candidate listed first. The candidates are the caller's to name
-- (who is on shift is not modelled here), so this is a staff action, not
-- a reaction to ticket creation.
rule StaffAutoAssignsTicket {
    when: AutoAssignTicket(ticket, candidates)
    requires: ticket.status = open
    requires: candidates.count > 0
    let chosen = least_loaded(candidates)
    ensures: ticket.status = in_progress
    ensures: ticket.assigned_to = chosen
    @guidance
        -- The second DCB showcase after `StaffMergesTickets`: the rule
        -- reads every candidate's open tickets across the whole ticket
        -- set, with no aggregate owning them. `src/helpdesk/auto_assign.rs`
        -- keys a `StaffWorkload` snapshot by a `staff` tag carried by
        -- `TicketAssigned`, `TicketResolved`, `TicketReopened` and
        -- `TicketsMerged`, and reads one per candidate. Two
        -- auto-assignments deciding at once conflict on the agents they
        -- both read, and the later one is decided again with the
        -- earlier one's assignment counted, so `least_loaded` always
        -- sees every assignment committed before its own.
        -- Assignments stored before the `staff` tag existed are not
        -- counted: skilj tags an event once, when it is appended.
}

-- Surfaces. Wires up every trigger above to an actual entry point -
-- resolves all of `allium analyse`'s unreachable-trigger findings from
-- the previous pass. Split into a public boundary (nobody has an
-- identity yet), and one portal each for Customer and StaffMember,
-- each split into a list/create surface and a single-ticket surface
-- (a surface's context binds one entity at a time - see
-- StaffTicketView/CustomerTicketView).

-- Weeded 2026-10-12: the two background binaries the multi-context move
-- added (src/bin/provisioner.rs, src/bin/lifecycle-replicator.rs) -
-- code, not people, holding superadmin-minted command tokens; the same
-- shape as activity.allium's EngagementWatcher.
actor PlatformReactor {
    identified_by: skilj/Role where superadmin = true
}

surface TenantProvisioning {
    facing reactor: PlatformReactor

    provides:
        RecordCompanyTenant(company, tenant)
}

surface TenantLifecycleReplication {
    facing reactor: PlatformReactor

    provides:
        RecordTenantLifecycle(company, status)
}

surface CompanySignup {
    provides:
        SignUpCompany(company_id, name, contact_email)
}

surface CompanyResubscription {
    facing staff: StaffMember

    provides:
        ReactivateCompany(staff.company)
            when staff.company.status = expired
}

surface CustomerPortal {
    facing customer: Customer

    exposes:
        for ticket in customer.company.tickets where requester = customer:
            ticket.title
            ticket.status
            ticket.priority
            ticket.created_at

    provides:
        CreateTicket(customer.company, customer, title, description, priority)
}

surface CustomerTicketView {
    facing customer: Customer
    context ticket: Ticket where requester = customer

    exposes:
        ticket.title
        ticket.description
        ticket.status
        ticket.priority
        ticket.assigned_to
        ticket.created_at
        ticket.resolved_at
        ticket.rating

    provides:
        CustomerRespondsToTicket(ticket, customer)
            when ticket.status = waiting_on_customer
        ReopenTicket(ticket)
            when ticket.status = resolved
        RateTicket(ticket, customer, rating)
            when ticket.status = resolved | closed and ticket.rating = null

    timeout:
        TicketAutoCloses
}

surface StaffSlaSettings {
    facing staff: StaffMember

    exposes:
        staff.company.sla_policy

    provides:
        SetCompanySlaPolicy(staff.company, policy)
}

surface StaffTicketQueue {
    facing staff: StaffMember

    exposes:
        for ticket in staff.company.tickets:
            ticket.title
            ticket.status
            ticket.priority
            ticket.requester
            ticket.assigned_to
            ticket.unhandled
            ticket.escalated
            ticket.created_at

    provides:
        LogTicketOnBehalf(staff.company, staff, requester, title, description, priority)
}

surface StaffTicketView {
    facing staff: StaffMember
    context ticket: Ticket where company = staff.company

    exposes:
        ticket.title
        ticket.description
        ticket.status
        ticket.priority
        ticket.requester
        ticket.assigned_to
        ticket.logged_by
        ticket.created_at
        ticket.resolved_at
        ticket.first_response_due_at
        ticket.resolution_due_at
        ticket.first_response_breached
        ticket.resolution_breached

    provides:
        AssignTicket(ticket, staff)
            when ticket.status = open
        AutoAssignTicket(ticket, candidates)
            when ticket.status = open
        RequestInfoFromCustomer(ticket, staff)
            when ticket.status = in_progress
        ResolveTicket(ticket, staff)
            when ticket.status = in_progress
        ReopenTicket(ticket)
            when ticket.status = resolved
        CloseTicket(ticket, staff)
            when ticket.status = resolved
        AddInternalNote(ticket, staff)
        MergeTickets(ticket, duplicate)
            when ticket.status = open | in_progress | waiting_on_customer | resolved
        ApplyMacro(ticket, macro, staff)
            when ticket.status not in {closed, merged}

    timeout:
        TicketAutoCloses
}

-- Staff-only: macros are internal tooling, never shown to customers.
surface StaffMacroLibrary {
    facing staff: StaffMember

    exposes:
        for macro in Macros where company = staff.company:
            macro.name
            macro.body
            macro.sets_status
            macro.sets_priority

    provides:
        CreateMacro(staff.company, macro_id, name, body, sets_status, sets_priority)
        UpdateMacro(macro, name, body, sets_status, sets_priority)
        DeleteMacro(macro)
}

-- Open questions: none currently. Every question raised during
-- elicitation so far has been resolved (see the "Resolved" comments
-- throughout) rather than left pending.
