# Rust build artifacts
/target/
frontend/target/
**/*.rs.bk
*.pdb

# Trunk (frontend build output)
frontend/dist/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.mcp.json

# OS cruft
.DS_Store
Thumbs.db

# Claude Code local overrides (project-shared settings stay tracked)
.claude/settings.local.json

# Logs
*.log

# alerter restart-safety checkpoint (src/bin/alerter.rs's own
# ALERTER_STATE_FILE) - local runtime state, not something to commit
/alerter-state.json
/alerter-state.json.tmp

# Browser test dependencies, traces, and disposable-stack credentials
/tests/browser/node_modules/
/tests/browser/test-results/
/tests/browser/playwright-report/
/tests/browser/.stack.json

# Python benchmark bytecode
__pycache__/

# Replay cursors owned by background consumers
/provisioner-state.json
/provisioner-state.json.tmp
/replicator-state.json
/replicator-state.json.tmp
/engagement-watcher-state.json
/engagement-watcher-state.json.tmp
